# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo

# Local tool path configuration (machine-specific, not committed)
cpld/.config.mk

# Mac metadata
.DS_Store

# App build artifacts (flat binaries + ELFs; .o already covered above)
apps/*/*.elf
apps/*/*.bin

# Generated code: griffin.generated.* are tracked (single source of truth);
# only the build stamp stays ignored.
.codegen.stamp
audio.raw
cf.bin
duart-setup-115200.mon
duart-setup-38400.mon
duart-setup-9600.mon
rom_even-read.bin
rom_odd-read.bin
