	(text "Atari DE-9: 1 up, 2 down, 3 left, 4 right, 5/9 paddle pots (SMS button 2 on 9), 6 fire,\n7 +5V (polyfuse), 8 GND.  Port 1 hosts the paddles: 1M pull-ups on 5/9 (the pot parallels\nthe pull-up), 10 nF ramp caps, 2N7000 dump FETs on PADDLE_DUMP; DNP the caps/FETs for a\nsticks-only build."
		(exclude_from_sim no)
		(at 177.8 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "36241f03-1ffa-4704-93ab-cdc9e161763d")
	)
	(text "ESD: 100R series + 1N4148 clamps to +5V/GND on every switch line, connector side.\nValues 100R, 1N4148, 10k, 1M, 10 nF and 0.5 A are assumptions;\ngriffin.md gives only the topology."
		(exclude_from_sim no)
		(at 177.8 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "92b0d5a3-6a73-41ae-89e1-88305c32aaa5")
	)
